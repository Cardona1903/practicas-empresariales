# RT-01: infraestructura institucional (PostgreSQL). Reemplazar con las
# credenciales reales que entregue el Departamento de TI de la Universidad.
DB_HOST=localhost
DB_PORT=5432
DB_USER=practicas_app
DB_PASSWORD=cambiar_esta_clave
DB_NAME=practicas_empresariales

PORT=3000

# ADR-004: clave/llave publica usada para validar los JWT que emite el SSO
# institucional (SIA). En desarrollo se puede usar un secreto simetrico.
SSO_JWT_SECRET=cambiar_este_secreto

# ADR-004: vencimiento del enlace de un solo uso para supervisores externos.
SUPERVISOR_TOKEN_EXPIRATION_HOURS=72
